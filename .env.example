# Copy to .env for local development. Never commit .env or provider credentials.

# -----------------------------------------------------------------------------
# LLM routing and script / graphic generation
# -----------------------------------------------------------------------------
# Primary script, visual-code, and critic provider.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
# GOOGLE_API_KEY is accepted as a fallback name by the script and visual agents.
GOOGLE_API_KEY=
LLM_PROVIDER=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Visual policy: on_demand creates a fresh, grammar-diverse visual module
# for every beat. Use hybrid only when a blueprint fallback is intentional.
VISUAL_GENERATION_MODE=on_demand
ENABLE_BESPOKE_VISUALS=true

# Local/Ollama fallback and vision critic.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
VLM_CRITIC_TIMEOUT_SECONDS=20
VLM_CRITIC_BATCH_TIMEOUT_SECONDS=120
VLM_OLLAMA_TIMEOUT_SECONDS=30
REPAIR_RENDER_TIMEOUT_SECONDS=180

# Inception Mercury 3 (OpenAI-compatible fast text/code generation)
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-3
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_REASONING_EFFORT=low
INCEPTION_TIMEOUT_SECONDS=45
# Keep false unless you explicitly want Mercury in the automatic fallback chain.
ENABLE_INCEPTION_FALLBACK=false

# -----------------------------------------------------------------------------
# Speech
# -----------------------------------------------------------------------------
TTS_PROVIDER=phonon
PHONON_TTS_MODEL=hf://gradium/phonon-31m-en
PHONON_TTS_VOICE=
PHONON_TTS_LANGUAGE=en
PHONON_TTS_QUANT=q8_0
PHONON_TTS_BIN=
PHONON_TTS_TIMEOUT_SECONDS=180
PHONON_TTS_THREADS=0
FAIL_ON_TTS_PROVIDER_FALLBACK=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=eric
ELEVENLABS_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
SARVAM_API_KEY=
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3
# Optional legacy Pocket TTS settings. Phonon is the production default.
POCKET_TTS_BIN=
POCKET_TTS_LANGUAGE=english_18m_2026-10
POCKET_TTS_VOICE=
POCKET_TTS_TIMEOUT_SECONDS=90

# -----------------------------------------------------------------------------
# Discovery, freshness, and local runtime
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
FFMPEG_BIN=
OFFLINE_MODE=false
MAX_CONTENT_AGE_DAYS=45
MAX_PERK_VERIFICATION_AGE_DAYS=60
STRICT_RECENCY_ENFORCEMENT=true
TOPIC_SELECTION_MODE=latest_or_viral
RESOLVE_SOURCE_ASSETS=true

# Audience-led 20-video YouTube experiment
CONTENT_STRATEGY_MODE=audience_led
CONTENT_STRATEGY_INCLUDE_GITHUB=true
CONTENT_STRATEGY_INCLUDE_HF_MODELS=true
AUDIENCE_PROFILE=global_ai_builder
EXPERIMENT_ID=global_builder_20_video
EXPERIMENT_TARGET_VIDEOS=20
EXPERIMENT_VIDEOS_PER_WEEK=5
EXPERIMENT_PRIMARY_PLATFORM=youtube
EXPERIMENT_SUCCESS_METRIC=qualified_growth
EXPERIMENT_CROSSPOST_POLICY=winners_only

# -----------------------------------------------------------------------------
# Publishing and quality gates
# -----------------------------------------------------------------------------
REQUIRE_VLM_QA=false
# Permit publishing when the remote vision provider is unavailable, while
# still blocking on a real low-scoring inspection.
ALLOW_VLM_PROVIDER_OUTAGE_PUBLISH=false
# Make CI fail loudly when a requested publisher does not actually publish.
FAIL_ON_PUBLISH_ERROR=true
PUBLISH_INSTAGRAM=false
PUBLISH_TWITTER=false
PUBLISH_X=false
PUBLISH_LINKEDIN=false
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_COVER_URL=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/callback
LINKEDIN_TOKEN_PATH=pipeline/linkedin_token.json
LINKEDIN_API_VERSION=202601

# Publishing credentials are optional for local development.
YOUTUBE_CLIENT_SECRETS_PATH=pipeline/client_secrets.json
YOUTUBE_TOKEN_PATH=pipeline/youtube_token.json
# Use 0 to let the OS choose a free local OAuth callback port.
YOUTUBE_OAUTH_PORT=0
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
