# Copy to .env for local development. Never commit .env or provider credentials.

# Script generation
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Speech
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=eric
SARVAM_API_KEY=
KOKORO_VOICE=am_eric

# Publishing is optional for local development.
YOUTUBE_CLIENT_SECRETS_PATH=pipeline/client_secrets.json
YOUTUBE_TOKEN_PATH=pipeline/youtube_token.json
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
