# Copy to .env for local development. Never commit .env or provider credentials.

# Script generation
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Inception Mercury 3 (OpenAI-compatible fast text/code generation)
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-3
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_REASONING_EFFORT=low
INCEPTION_TIMEOUT_SECONDS=45
# Keep false unless you explicitly want Mercury in the automatic fallback chain.
ENABLE_INCEPTION_FALLBACK=false

# Speech
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=eric
SARVAM_API_KEY=
# Optional local CPU TTS. Install Kyutai's official pocket-tts binary first.
POCKET_TTS_BIN=
POCKET_TTS_LANGUAGE=english_18m_2026-10
POCKET_TTS_VOICE=
POCKET_TTS_TIMEOUT_SECONDS=90

# Publishing is optional for local development.
YOUTUBE_CLIENT_SECRETS_PATH=pipeline/client_secrets.json
YOUTUBE_TOKEN_PATH=pipeline/youtube_token.json
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
