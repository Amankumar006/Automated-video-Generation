{
  "id": "sora_mechanism_deepdive",
  "title": "Sora: The World Simulator Behind Text\u2011to\u2011Video",
  "category": "mechanism_deepdive",
  "domain_taxonomy": "neural_attention",
  "hook_tag": "VIDEO\u202fSPEED\u202fREBELLION",
  "beats": [
    {
      "beat_id": 1,
      "text": "One GPU now renders minutes of video, while a year ago you needed a server farm.",
      "visual_focus": "single GPU icon exploding with speed lines",
      "highlight_words": {
        "One GPU": "#EF4444"
      },
      "svo_action": {
        "subject": "Single GPU",
        "action_verb": "outpaces",
        "direct_object": "GPU farms",
        "anchor_word": "now",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "vector_flow_field",
        "title": "GPU SPEED REBELLION",
        "sub": "From farm to single",
        "accent_color": "#38BDF8",
        "params": {
          "field_title": "Temporal\u2011Spatial Flow",
          "source_label": "Text Prompt",
          "target_label": "Pixel Frame",
          "stream_formula": "$\\mathbf{v}(t) = f(\\mathbf{z}_0, t)$"
        }
      },
      "thriller_role": "pattern_interrupt_hook",
      "act": 1
    },
    {
      "beat_id": 2,
      "text": "The villain is a monolithic denoiser that recomputes every pixel each frame, turning the pipeline into a city\u2011wide traffic jam.",
      "visual_focus": "grid of red traffic lights overlaying video frames",
      "highlight_words": {
        "monolithic denoiser": "#EF4444"
      },
      "svo_action": {
        "subject": "Monolithic denoiser",
        "action_verb": "clogs",
        "direct_object": "pixel computation",
        "anchor_word": "recomputes",
        "semantic_role": "obstruction"
      },
      "visual_blueprint": {
        "layout": "attention_prism_refraction",
        "title": "BOTTLE\u2011NECK",
        "sub": "Pixel\u2011by\u2011pixel stall",
        "accent_color": "#38BDF8",
        "params": {
          "token_label": "Frame Token",
          "matrix_title": "N\u00b2 Attention Scores"
        }
      },
      "thriller_role": "villain_introduction",
      "act": 2
    },
    {
      "beat_id": 3,
      "text": "Sora flips the script with a two\u2011stage pipeline: an encoder caches a full\u2011frame feature map once per second, then reuses it for every frame.",
      "visual_focus": "two stacked blocks: encoder cache \u2192 reused feature map",
      "highlight_words": {
        "two\u2011stage pipeline": "#EF4444"
      },
      "svo_action": {
        "subject": "Encoder",
        "action_verb": "caches",
        "direct_object": "full\u2011frame map",
        "anchor_word": "once",
        "semantic_role": "precompute"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "CACHED FEATURE PIPELINE",
        "sub": "Encode once, reuse forever",
        "accent_color": "#38BDF8",
        "params": {
          "input_label": "Text Embedding",
          "router_label": "Stage Selector",
          "branch_a_label": "Spatial UNet",
          "branch_a_sub": "Per\u2011frame Encoder",
          "branch_b_label": "Temporal Flow",
          "branch_b_sub": "Velocity Predictor"
        }
      },
      "thriller_role": "eureka_pivot",
      "act": 3
    },
    {
      "beat_id": 4,
      "text": "A single fused forward pass then processes only the temporal delta\u2014pixels that actually move\u2014synchronizing just the changing slice each step.",
      "visual_focus": "wave animation over only moving pixels",
      "highlight_words": {
        "temporal delta": "#EF4444"
      },
      "svo_action": {
        "subject": "Fused forward pass",
        "action_verb": "processes",
        "direct_object": "temporal delta",
        "anchor_word": "only",
        "semantic_role": "optimization"
      },
      "visual_blueprint": {
        "layout": "neural_activation_wave",
        "title": "DELTA\u2011SYNC",
        "sub": "Only moving pixels",
        "accent_color": "#38BDF8",
        "params": {
          "input_label": "Latent Noise",
          "hidden_label": "Flow Predictor",
          "output_label": "Velocity Field"
        }
      },
      "thriller_role": "technical_deep_dive",
      "act": 3
    },
    {
      "beat_id": 5,
      "text": "Result: 60\u202ffps real\u2011time video, an 800\u202f% speedup over Imagen\u202fVideo\u2019s 7.5\u202ffps, on identical single\u2011GPU hardware, without extra memory tricks.",
      "visual_focus": "speedometer needle soaring to 60\u202ffps",
      "highlight_words": {
        "800\u202f% speedup": "#EF4444"
      },
      "svo_action": {
        "subject": "Sora",
        "action_verb": "delivers",
        "direct_object": "60\u202ffps video",
        "anchor_word": "Result",
        "semantic_role": "performance_gain"
      },
      "visual_blueprint": {
        "layout": "comparison_side_by_side",
        "title": "PERFORMANCE BREAKTHROUGH",
        "sub": "800\u202f% faster",
        "accent_color": "#38BDF8",
        "params": {
          "col_a_title": "Sora",
          "col_a_stat": "8\u00d7 FPS",
          "col_b_title": "Prev Diffusion",
          "col_b_stat": "1\u00d7 FPS"
        }
      },
      "thriller_role": "empirical_victory",
      "act": 4
    },
    {
      "beat_id": 6,
      "text": "Now that lone GPU sprints video, the old farm\u2011size bottleneck is just dust in the rearview.",
      "visual_focus": "single GPU racing past a cloud of server silhouettes",
      "highlight_words": {
        "lone GPU": "#EF4444"
      },
      "svo_action": {
        "subject": "Lone GPU",
        "action_verb": "sprints",
        "direct_object": "video generation",
        "anchor_word": "Now",
        "semantic_role": "new_state"
      },
      "visual_blueprint": {
        "layout": "horizontal_race_bars",
        "title": "NEW REALITY",
        "sub": "From farms to fast lanes",
        "accent_color": "#10B981",
        "params": {}
      },
      "thriller_role": "paradigm_shift_outro",
      "act": 4
    }
  ],
