      "visual_blueprint": {
        "layout": "chalkboard_code_block",
        "title": "KERNEL CODE: DIFFERENTIAL TRANS",
        "sub": "Two parallel attention matrices appear, a subtraction animation r",
        "params": {
          "title": "KERNEL CODE: DIFFERENTIAL TRANS",
          "sub": "Two parallel attention matrices appear, a subtraction animation r",
          "filename": "diff_attention.py",
          "language": "python",
          "lines": [
            "def differential_attention(q, k, beta):",
            "    a1 = torch.softmax(q @ k.T, dim=-1)",
            "    a2 = torch.softmax(q @ k.T + beta, dim=-1)",
            "    delta = a1 - a2",
            "    return torch.topk(F.relu(delta), k=64, dim=-1).indices"
          ],
