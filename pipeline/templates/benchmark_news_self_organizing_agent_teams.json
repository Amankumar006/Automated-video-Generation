  "beats": [
    {
      "beat_id": 1,
      "text": "Why do some AI teams fail while others solve hard math puzzles with ease? It is not about the members, but how they organize.",
      "visual_focus": "A scattered group of glowing nodes (agents) forming a structured, synchronized ring.",
      "highlight_words": {
        "organize": "#34D399"
      },
      "svo_action": {
        "subject": "Agent Team",
        "action_verb": "organizes",
        "direct_object": "Collaborative Reasoning Structure",
        "anchor_word": "organize",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 2,
      "text": "Think of a jazz band. No one has a script; they learn to listen, trade, and play off each other to build a new sound.",
      "visual_focus": "Musical notes flowing between agents as they refine a shared, complex solution path.",
      "highlight_words": {
        "jazz band": "#38BDF8"
      },
      "svo_action": {
        "subject": "Agent Teams",
        "action_verb": "mimics",
        "direct_object": "Dynamic Jazz Improvisation",
        "anchor_word": "jazz",
        "semantic_role": "state_transition"
      }
    },
    {
      "beat_id": 3,
      "text": "Scientists built a way for agents to practice together. They trade, test, and fix their logic until they find the truth through sheer teamwork.",
      "visual_focus": "Data packets moving back and forth; incorrect paths fade away while the correct one grows bright.",
      "highlight_words": {
        "practice": "#34D399"
      },
      "svo_action": {
        "subject": "Collaborative Computation",
        "action_verb": "synthesizes",
        "direct_object": "Partial Reasoning Fragments",
        "anchor_word": "truth",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 4,
      "text": "The team checks if the answer works. Like picking a winning idea from a pile, they learn to spot good logic from pure noise.",
      "visual_focus": "A filter sorting through reasoning chains, keeping only the coherent, correct steps.",
      "highlight_words": {
        "logic": "#F59E0B"
      },
      "svo_action": {
        "subject": "Demonstrability Filter",
        "action_verb": "prunes",
        "direct_object": "Incorrect Reasoning Branches",
        "anchor_word": "logic",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 5,
      "text": "These self-led teams now beat their best single member, solving complex physics and math problems by shaping ideas no single agent could reach alone.",
      "visual_focus": "A rising bar chart showing the Team performance (66.7%) significantly higher than the strongest individual agent (48.8%).",
      "highlight_words": {
        "beat": "#34D399"
      },
      "svo_action": {
        "subject": "Self-Organizing Team",
        "action_verb": "surpasses",
        "direct_object": "Strongest Independent Agent",
        "anchor_word": "beat",
        "semantic_role": "metric_evaluation"
      }
    },
    {
      "beat_id": 6,
      "text": "Follow The Model Verse for simple explanations of how modern AI actually works.",
      "visual_focus": "The Model Verse logo appears in center screen with a soft, clean glow.",
      "highlight_words": {
        "The Model Verse": "#34D399"
      },
      "svo_action": {
        "subject": "Viewer",
        "action_verb": "follows",
        "direct_object": "The Model Verse",
        "anchor_word": "Follow",
        "semantic_role": "agent_action"
      }
    }
  ],
