  "hook_tag": "CINEMATIC PROMPT SCALING",
  "beats": [
    {
      "beat_id": 1,
      "text": "Why do video AI tools struggle to keep a movie scene steady? They lack a director to plan the shot for long, clear clips.",
      "visual_focus": "A chaotic montage of blurry video clips snapping into a smooth, storyboarded sequence.",
      "highlight_words": {
        "video AI": "#38BDF8",
        "director": "#F59E0B"
      },
      "svo_action": {
        "subject": "AI Model",
        "action_verb": "maps",
        "direct_object": "Cinematic Trajectory",
        "anchor_word": "plan",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 2,
      "text": "Think of it like writing a script. A raw prompt is just a rough idea, like a napkin sketch instead of a final movie plan.",
      "visual_focus": "A hand scribbling on a napkin versus a complex, multi-layered movie production storyboard.",
      "highlight_words": {
        "raw prompt": "#EF4444",
        "movie plan": "#34D399"
      },
      "svo_action": {
        "subject": "User Prompt",
        "action_verb": "scales",
        "direct_object": "Production Complexity",
        "anchor_word": "sketch",
        "semantic_role": "state_transition"
      }
    },
    {
      "beat_id": 3,
      "text": "WanPE fixes this by looking at real films. It learns to work backward, tracing a full shot back to a perfect, simple text command.",
      "visual_focus": "A reverse-engineering animation where a video frame dissolves into a structured text screenplay line.",
      "highlight_words": {
        "work backward": "#34D399",
        "perfect": "#FFFFFF"
      },
      "svo_action": {
        "subject": "WanPE Model",
        "action_verb": "reconstructs",
        "direct_object": "Semantic Screenplay",
        "anchor_word": "backward",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 4,
      "text": "It uses a special loop to check if the scene stays true to your intent, pruning away ideas that do not fit the main plot.",
      "visual_focus": "A logic gate filtering glowing concept threads, keeping only those aligned with the user goal.",
      "highlight_words": {
        "special loop": "#F59E0B",
        "pruning": "#EF4444"
      },
      "svo_action": {
        "subject": "Semantic Loop",
        "action_verb": "filters",
        "direct_object": "Incoherent Scenes",
        "anchor_word": "pruning",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 5,
      "text": "This leads to a fifty point jump in human preference for thirty second clips. It creates truly professional art from simple words.",
      "visual_focus": "A side-by-side comparison showing a shaky raw video versus a stable, cinematic high-fidelity production.",
      "highlight_words": {
        "fifty point jump": "#34D399"
      },
      "svo_action": {
        "subject": "Cinematic Plan",
        "action_verb": "elevates",
        "direct_object": "Human Preference Score",
        "anchor_word": "jump",
        "semantic_role": "metric_evaluation"
      }
    },
    {
      "beat_id": 6,
      "text": "Follow The Model Verse for simple explanations of how modern AI actually works.",
      "visual_focus": "The Model Verse logo pulsing with a clean, cinematic light effect.",
      "highlight_words": {
        "The Model Verse": "#34D399"
      },
      "svo_action": {
        "subject": "User",
        "action_verb": "follows",
        "direct_object": "The Model Verse",
        "anchor_word": "Follow",
        "semantic_role": "agent_action"
      }
    }
  ],
