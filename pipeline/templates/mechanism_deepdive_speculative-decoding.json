          "col_b_stat": "38\u202fms"
        }
      },
      "thriller_role": "empirical_payoff",
      "act": 4
    },
    {
      "beat_id": 6,
      "text": "Follow The Model Verse for daily deep-dives into how modern AI actually works under the hood.",
      "visual_focus": "The Model Verse logo pulsing with a subtle neural network grid background.",
      "highlight_words": {
        "The Model Verse": "#38BDF8"
      },
      "svo_action": {
        "subject": "Viewer",
