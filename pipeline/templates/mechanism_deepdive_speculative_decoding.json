        "params": {
          "title": "KERNEL CODE: SPECULATIVE DECODI",
          "sub": "A small, fast node (draft) firing a chain of 5 tokens into a mass",
          "filename": "sprouting_decoder.py",
          "language": "python",
          "lines": [
