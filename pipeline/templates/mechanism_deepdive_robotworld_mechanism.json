{
  "id": "robotworld_mechanism",
  "title": "RobotWorld: Embodied Benchmark Unleashes Real\u2011Contact Physics",
  "category": "mechanism_deepdive",
  "domain_taxonomy": "robotics_tamp",
  "hook_tag": "SIM\u2011REALITY GAP",
  "beats": [
    {
      "beat_id": 1,
      "text": "In a flawless sim, a robot lifts a mug. In reality, it drops it. Every single time.",
      "visual_focus": "split_flow visual of sim robot lifting mug vs real robot dropping mug",
      "highlight_words": {
        "drops it": "#EF4444"
      },
      "svo_action": {
        "subject": "Simulation",
        "action_verb": "contradicts",
        "direct_object": "reality",
        "anchor_word": "paradox",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "vector_flow_field",
        "title": "SIM VS REAL",
        "sub": "Mug lift paradox",
        "accent_color": "#38BDF8",
        "params": {
          "field_title": "Contact Flow Divergence",
          "source_label": "Ideal Motion",
          "target_label": "Stalled Motion",
          "stream_formula": "$|\\mathcal{E}| = 100$"
        }
      },
      "thriller_role": "pattern_interrupt_hook",
      "act": 1
    },
    {
      "beat_id": 2,
      "text": "The contact bottleneck turns every fingertip into a full\u2011body physics solve, choking the CPU like a rush\u2011hour intersection, blocking the scheduler and stalling every subsequent limb.",
      "visual_focus": "traffic_jam analogy overlay on CPU usage chart",
      "highlight_words": {
        "Contact Bottleneck": "#EF4444"
      },
      "svo_action": {
        "subject": "Contact",
        "action_verb": "chokes",
        "direct_object": "CPU",
        "anchor_word": "traffic jam",
        "semantic_role": "obstacle"
      },
      "visual_blueprint": {
        "layout": "neural_activation_wave",
        "title": "CPU JAM",
        "sub": "Full-body solves per fingertip",
        "accent_color": "#38BDF8",
        "params": {
          "layer_label": "Contact Computation Layer",
          "wave_type": "Quadratic Explosion"
        }
      },
      "thriller_role": "villain_introduction",
      "act": 2
    },
    {
      "beat_id": 3,
      "text": "The breakthrough: a hierarchical contact graph that organizes tiny patches into a tree, like folders in a file system for each robot limb.",
      "visual_focus": "tree diagram of hierarchical contact graph resembling file system",
      "highlight_words": {
        "Hierarchical Contact Graph": "#EF4444"
      },
      "svo_action": {
        "subject": "Graph",
        "action_verb": "organizes",
        "direct_object": "contact patches",
        "anchor_word": "folders",
        "semantic_role": "structure"
      },
      "visual_blueprint": {
        "layout": "tree_hierarchy",
        "title": "CONTACT TREE",
        "sub": "Folder\u2011like patches per limb",
        "accent_color": "#38BDF8",
        "params": {
          "root_label": "World Root",
          "optimal_label": "Sparse Force Path",
          "pruned_label": "Redundant Contacts"
        }
      },
      "thriller_role": "eureka_pivot",
      "act": 3
    },
    {
      "beat_id": 4,
      "text": "Solver walks the tree bottom\u2011up, resolves physics locally at leaf patches, then aggregates forces upward, pruning irrelevant branches for the current timestep.",
      "visual_focus": "bottom\u2011up traversal animation highlighting leaf solves and upward aggregation",
      "highlight_words": {
        "bottom\u2011up traversal": "#EF4444"
      },
      "svo_action": {
        "subject": "Solver",
        "action_verb": "aggregates",
        "direct_object": "forces",
        "anchor_word": "prunes",
        "semantic_role": "computation"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "TRAVERSAL",
        "sub": "Leaf to root aggregation",
        "accent_color": "#38BDF8",
        "params": {
          "input_label": "Contact Clusters",
          "router_label": "Impedance Gate",
          "branch_a_label": "Pass",
          "branch_a_sub": "g_i > \u03c4",
          "branch_b_label": "Block",
          "branch_b_sub": "g_i \u2264 \u03c4"
        }
      },
      "thriller_role": "secret_sauce",
      "act": 3
    },
    {
      "beat_id": 5,
      "text": "RobotWorld reaches 86% task success\u2014outpacing MuJoCo\u2019s 62% and Gym\u2019s 55%\u2014a 24% boost on identical hardware in the standard benchmark suite.",
      "visual_focus": "bar chart comparing success rates: RobotWorld, MuJoCo, Gym",
      "highlight_words": {
        "86%": "#EF4444"
      },
      "svo_action": {
        "subject": "RobotWorld",
        "action_verb": "achieves",
        "direct_object": "86% success",
        "anchor_word": "boost",
        "semantic_role": "performance"
      },
      "visual_blueprint": {
        "layout": "comparison_side_by_side",
        "title": "SUCCESS RATES",
        "sub": "Benchmark breakout",
        "accent_color": "#38BDF8",
        "params": {
          "col_a_title": "Baseline",
          "col_a_stat": "62% Success",
          "col_b_title": "RobotWorld",
          "col_b_stat": "86% Success"
        }
      },
      "thriller_role": "empirical_victory",
      "act": 4
    },
    {
      "beat_id": 6,
      "text": "Next time a robot drops a mug, remember the hidden contact tree that could have saved it.",
      "visual_focus": "closing loop animation returning to mug drop scene, overlaying contact tree ghost",
      "highlight_words": {
        "contact tree": "#EF4444"
      },
      "svo_action": {
        "subject": "Viewer",
        "action_verb": "remembers",
        "direct_object": "contact tree",
        "anchor_word": "loop",
        "semantic_role": "recall"
      },
      "visual_blueprint": {
        "layout": "projection_rays",
