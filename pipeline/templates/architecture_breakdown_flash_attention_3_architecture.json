    {
      "beat_id": 4,
      "text": "Using cp.async instructions, we fetch tiles into shared memory while Tensor Cores crunch the previous batch in parallel.",
      "visual_focus": "Code snippet showing cp.async and Tensor Core operations in a loop.",
      "highlight_words": {
        "cp.async": "#3B82F6"
      },
      "svo_action": {
        "subject": "cp.async",
        "action_verb": "fetches",
        "direct_object": "Tiles",
        "anchor_word": "parallel",
        "semantic_role": "technical_mechanism"
      },
      "visual_blueprint": {
        "layout": "chalkboard_code_block",
        "title": "KERNEL CODE: FLASHATTENTION-3: ",
        "sub": "Code snippet showing cp.async and Tensor Core operations in a loo",
        "params": {
          "title": "KERNEL CODE: FLASHATTENTION-3: ",
          "sub": "Code snippet showing cp.async and Tensor Core operations in a loo",
          "filename": "attention_kernel.cu",
          "language": "cpp",
          "lines": [
            "// Async copy from HBM to SRAM",
            "cp.async.bulk.tensor.g2s.tile(sram, hbm);",
            "// Execute Tensor Core math in parallel",
            "mma.sync.aligned.m16n8k16(d, a, b, c);"
          ],
          "highlight_lines": [
            2,
