    {
      "beat_id": 2,
      "text": "The HBM bus is a narrow pipe, a bottleneck forcing your compute units to sit idle while data trickles in.",
      "visual_focus": "A wide pipe narrowing into a tiny straw, choking the flow of data.",
      "highlight_words": {
        "bottleneck": "#EF4444"
      },
      "svo_action": {
        "subject": "HBM Bus",
        "action_verb": "chokes",
        "direct_object": "Compute",
