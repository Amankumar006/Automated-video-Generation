    {
      "beat_id": 3,
      "text": "FlashAttention-3 shatters this by overlapping data movement with math execution, effectively hiding the latency of the memory bus.",
      "visual_focus": "Two parallel tracks: one for data, one for math, moving simultaneously.",
      "highlight_words": {
        "overlapping": "#22C55E"
      },
      "svo_action": {
        "subject": "FlashAttention-3",
        "action_verb": "hides",
