      "svo_action": {
        "subject": "FlashAttention-3",
        "action_verb": "hides",
        "direct_object": "latency",
        "anchor_word": "overlap",
        "semantic_role": "eureka_moment"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "ASYNC OVERLAP",
        "sub": "Hiding Latency",
