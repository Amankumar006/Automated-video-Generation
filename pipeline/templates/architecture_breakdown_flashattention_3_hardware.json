  "beats": [
    {
      "beat_id": 1,
      "text": "Before you train your next model, see how FlashAttention-3 cuts 98.2% of memory overhead.",
      "visual_focus": "Split screen showing a GPU core idling vs a memory bus bottleneck.",
      "highlight_words": {
        "wasting cycles": "#EF4444"
      },
      "svo_action": {
        "subject": "Memory Latency",
        "action_verb": "strangles",
        "direct_object": "Compute Throughput",
        "anchor_word": "gridlock",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "horizontal_race_bars",
        "title": "THE COMPUTE WALL",
        "sub": "Memory bandwidth is the real bottleneck",
        "accent_color": "#EF4444",
        "params": {
          "metric_name": "Compute Utilization",
          "unit": "%"
        }
      },
      "thriller_role": "pattern_interrupt_hook",
      "act": 1,
      "hook_score": 71,
      "hook_band": "WORKABLE",
      "hook_formula": "The Statistic"
    },
    {
      "beat_id": 2,
      "text": "The villain is synchronous execution. Compute units sit paralyzed while the memory bus struggles to feed them tokens.",
      "visual_focus": "Animation of a processor core turning gray while waiting for a data packet.",
      "highlight_words": {
        "paralyzed": "#EF4444"
      },
      "svo_action": {
        "subject": "Synchronous Execution",
        "action_verb": "freezes",
        "direct_object": "Processing Pipeline",
        "anchor_word": "paralyzed",
        "semantic_role": "bottleneck_definition"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "THE SYNCHRONOUS TRAP",
        "sub": "Waiting for data is death",
        "accent_color": "#EF4444",
        "params": {}
      },
      "thriller_role": "villain_bottleneck",
      "act": 2
    },
    {
      "beat_id": 3,
      "text": "FlashAttention-3 pivots to asynchrony, decoupling data movement from computation to overlap them perfectly in the pipeline.",
      "visual_focus": "Two parallel tracks: one for data loading, one for compute, moving simultaneously.",
      "highlight_words": {
        "asynchrony": "#22C55E"
      },
      "svo_action": {
        "subject": "Asynchrony",
        "action_verb": "decouples",
        "direct_object": "Memory and Compute",
        "anchor_word": "overlap",
        "semantic_role": "architectural_pivot"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "THE ASYNC PIVOT",
        "sub": "Compute and memory in parallel",
        "accent_color": "#34D399",
        "params": {
          "input_label": "Token Stream",
          "router_label": "Async Controller",
          "branch_a_label": "Compute Cores",
          "branch_b_label": "SRAM Buffer"
        }
      },
      "thriller_role": "eureka_mechanism",
      "act": 3
    },
    {
      "beat_id": 4,
      "text": "It leverages cp_async and mma_sync instructions to hide memory latency behind active compute cycles, maximizing raw throughput.",
      "visual_focus": "Code snippet highlighting cp_async and mma_sync calls.",
      "highlight_words": {
        "cp_async": "#3B82F6",
        "mma_sync": "#3B82F6"
