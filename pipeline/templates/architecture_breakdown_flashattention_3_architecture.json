      "thriller_role": "villain_bottleneck",
      "act": 2
    },
    {
      "beat_id": 3,
      "text": "FlashAttention-3 shatters this by decoupling compute and memory, forcing the hardware to overlap operations through asynchronous execution.",
      "visual_focus": "Two parallel streams of data merging into one continuous, high-speed flow.",
      "highlight_words": {
        "asynchronous execution": "#22C55E"
      },
      "svo_action": {
