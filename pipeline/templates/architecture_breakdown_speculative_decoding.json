    "language": "python",
    "lines": [
      "def speculative_generate(prompt):",
      "draft_tokens = draft_model.sample(prompt, lookahead=K)",
      "verified = verifier.check(draft_tokens)",
      "return merge(draft_tokens, verified)"
    ],
