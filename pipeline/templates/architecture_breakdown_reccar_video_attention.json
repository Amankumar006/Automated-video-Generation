{
  "id": "reccar_video_attention",
  "title": "Closing the Cross-Attention Gap",
  "category": "architecture_breakdown",
  "domain_taxonomy": "neural_attention",
  "hook_tag": "CROSS-MODAL ALIGNMENT GAP",
  "beats": [
    {
      "beat_id": 1,
      "text": "Why do AI models get video right but fail to sync sound or motion? It feels like the two sides don't talk well enough.",
      "visual_focus": "A split-screen showing a video stream on the left and audio waveform on the right, with a broken bridge connecting them.",
      "highlight_words": {
        "sync": "#EF4444",
        "talk": "#38BDF8"
      },
      "svo_action": {
        "subject": "AI Model",
        "action_verb": "fails",
        "direct_object": "Modality Sync",
        "anchor_word": "fail",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 2,
      "text": "Think of a student reading a book. They track the text well, but the book does not track where their eyes are looking back.",
      "visual_focus": "An illustration of a student's eyes moving across a page, representing the one-way street of information.",
      "highlight_words": {
        "one-way": "#EF4444"
      },
      "svo_action": {
        "subject": "Student",
        "action_verb": "reads",
        "direct_object": "Book Text",
        "anchor_word": "reading",
        "semantic_role": "state_transition"
      }
    },
    {
      "beat_id": 3,
      "text": "We fix this with a bridge. We make the sound and motion look at the video with the same care the video uses.",
      "visual_focus": "A glowing bridge forming between the audio icons and the video stream on the chalkboard.",
      "highlight_words": {
        "bridge": "#34D399"
      },
      "svo_action": {
        "subject": "Bridge Mechanism",
        "action_verb": "aligns",
        "direct_object": "Modality Correspondence",
        "anchor_word": "bridge",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 4,
      "text": "Our rule forces the weak side to match the strong side. It treats both like equal partners dancing in a perfectly timed loop.",
      "visual_focus": "A math constraint pulling two graphs together until their peaks overlap perfectly.",
      "highlight_words": {
        "forces": "#F59E0B",
        "equal": "#34D399"
      },
      "svo_action": {
        "subject": "RecCAR Rule",
        "action_verb": "forces",
        "direct_object": "Correspondence Gap",
        "anchor_word": "forces",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 5,
      "text": "The result is clear. Humans look more real, and the sound matches the image, cutting down on messy blurs and timing drifts.",
      "visual_focus": "A blurry video sharpening into a crisp image with audio peaks perfectly synced to mouth movements.",
      "highlight_words": {
        "clear": "#34D399"
      },
      "svo_action": {
        "subject": "Regularization",
        "action_verb": "improves",
        "direct_object": "Human Anatomy Score",
        "anchor_word": "result",
        "semantic_role": "metric_evaluation"
      }
    },
    {
      "beat_id": 6,
      "text": "Follow The Model Verse for simple explanations of how modern AI actually works.",
      "visual_focus": "The Model Verse logo pulsing in the center of the screen.",
      "highlight_words": {
        "Model Verse": "#34D399"
      },
      "svo_action": {
        "subject": "The Model Verse",
        "action_verb": "explains",
        "direct_object": "AI Mechanisms",
        "anchor_word": "explanations",
        "semantic_role": "agent_action"
      }
    }
  ],
