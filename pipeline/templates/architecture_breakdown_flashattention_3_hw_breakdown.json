  "hook_tag": "MEMORY BANDWIDTH KILLER",
  "beats": [
    {
      "beat_id": 1,
      "text": "Your H100 GPU is mostly idling, starving for data while its compute cores sit completely paralyzed.",
      "visual_focus": "A glowing H100 chip pulsing red, then freezing.",
      "highlight_words": {
        "mostly idling": "#EF4444"
      },
      "svo_action": {
        "subject": "Memory Latency",
        "action_verb": "strangles",
        "direct_object": "Compute Throughput",
        "anchor_word": "starving",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "grid_memory",
        "title": "THE IDLE PARADOX",
        "sub": "Hardware utilization is a lie",
        "accent_color": "#EF4444",
        "params": {
          "grid_title": "HBM Bandwidth Latency",
          "active_cell_label": "Idle Core Cycle",
          "efficiency_label": "Data Starvation"
        }
      },
      "thriller_role": "pattern_interrupt_hook",
      "act": 1
    },
    {
      "beat_id": 2,
      "text": "The villain is synchronous execution. It\u2019s a relay race where the runner stops dead to wait for the baton.",
      "visual_focus": "Split screen: Compute cores vs. HBM memory lanes.",
      "highlight_words": {
        "synchronous execution": "#EF4444"
      },
      "svo_action": {
        "subject": "Synchronous Bottleneck",
        "action_verb": "forces",
        "direct_object": "Hardware Stagnation",
        "anchor_word": "wait",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "side_by_side",
        "title": "THE RELAY BOTTLENECK",
        "sub": "Waiting for HBM to SRAM transfer",
        "accent_color": "#EF4444",
        "params": {}
      },
      "thriller_role": "villain_bottleneck",
      "act": 2
    },
    {
      "beat_id": 3,
      "text": "FlashAttention-3 shatters this by decoupling the compute from the memory load using asynchronous tile-based scheduling.",
      "visual_focus": "Tiling pattern overlapping on a matrix grid.",
      "highlight_words": {
        "asynchronous": "#22C55E"
      },
      "svo_action": {
        "subject": "Asynchronous Scheduling",
        "action_verb": "decouples",
        "direct_object": "Execution Flow",
        "anchor_word": "shatters",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "split_flow",
        "title": "ASYNC TILING",
        "sub": "Overlapping math and data movement",
        "accent_color": "#34D399",
        "params": {
          "input_label": "Input Block",
          "router_label": "TMA Unit",
          "branch_a_label": "Compute Stream",
          "branch_a_sub": "Tensor Cores",
          "branch_b_label": "Load Stream",
          "branch_b_sub": "HBM -> SRAM"
        }
      },
      "thriller_role": "eureka_pivot",
      "act": 3
    },
    {
      "beat_id": 4,
      "text": "It hides memory latency by overlapping FP8 matrix multiplication with asynchronous data copies directly on the tensor cores.",
      "visual_focus": "Code block showing warp-level asynchronous copy instructions.",
      "highlight_words": {
        "FP8": "#22C55E"
      },
      "svo_action": {
        "subject": "Tensor Cores",
        "action_verb": "execute",
        "direct_object": "Overlapped Operations",
        "anchor_word": "hides",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
        "layout": "attention_prism_refraction",
        "title": "FP8 PIPELINING",
        "sub": "Hiding latency in the pipeline",
        "accent_color": "#F59E0B",
        "params": {
          "token_label": "Block Tile",
          "matrix_title": "FP8 Warp Throughput"
        }
      },
      "thriller_role": "technical_deep_dive",
      "act": 3
    },
    {
      "beat_id": 5,
      "text": "The result? 75% hardware utilization, delivering a massive 1.5x to 2x speedup over previous attention kernels.",
      "visual_focus": "Bar chart showing performance leap.",
      "highlight_words": {
        "75%": "#22C55E"
      },
      "svo_action": {
        "subject": "FlashAttention-3",
        "action_verb": "delivers",
        "direct_object": "Blistering Throughput",
        "anchor_word": "speedup",
        "semantic_role": "state_transition"
      },
      "visual_blueprint": {
