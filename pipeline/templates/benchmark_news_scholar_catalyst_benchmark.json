  "beats": [
    {
      "beat_id": 1,
      "text": "Your RAG system is failing because it treats research like a keyword search, missing the invisible threads that actually connect breakthrough scientific ideas.",
      "visual_focus": "A massive, chaotic cloud of floating paper icons being filtered by a simple, failing search bar.",
      "highlight_words": {
        "invisible threads": "#EF4444"
      },
      "svo_action": {
        "subject": "RAG system",
        "action_verb": "misses",
        "direct_object": "contextual threads",
        "anchor_word": "failing",
        "semantic_role": "failure_mode"
      },
      "visual_blueprint": {
        "layout": "grid_memory",
        "title": "THE RAG LIMIT",
        "sub": "Keyword retrieval vs. Semantic intuition",
        "accent_color": "#EF4444",
        "params": {}
      }
    },
    {
      "beat_id": 2,
      "text": "Standard agents act like librarians who only know the Dewey Decimal system, while human scientists act like archivists who know which specific paper sparked an epiphany.",
      "visual_focus": "Split screen: A rigid, linear library shelf on the left; a complex, interconnected neural web of citations on the right.",
      "highlight_words": {
        "epiphany": "#F59E0B"
      },
      "svo_action": {
        "subject": "Agents",
        "action_verb": "lack",
        "direct_object": "scientific intuition",
        "anchor_word": "librarians",
        "semantic_role": "analogy_contrast"
      },
      "visual_blueprint": {
        "layout": "horizontal_race_bars",
        "title": "INTUITION GAP",
        "sub": "Agentic search vs. Expert insight",
        "accent_color": "#F59E0B",
        "params": {}
      }
    },
    {
      "beat_id": 3,
      "text": "ScholarCatalyst fixes this by building a graph-based index using author-defined citations, mapping exactly which prior works were essential to 207 recent computer science papers.",
      "visual_focus": "A graph database visualization where nodes represent papers and edges represent author-validated causal links.",
      "highlight_words": {
        "graph-based index": "#10B981"
      },
      "svo_action": {
        "subject": "ScholarCatalyst",
        "action_verb": "maps",
        "direct_object": "causal links",
        "anchor_word": "graph-based",
        "semantic_role": "mechanism_breakdown"
      },
      "visual_blueprint": {
        "layout": "ast_tree",
        "title": "SCHOLAR CATALYST",
        "sub": "Author-validated citation graph",
        "accent_color": "#10B981",
        "params": {}
      }
    },
    {
      "beat_id": 4,
      "text": "Even Claude Fable 5.1 hits a ceiling at 0.51 R@20, proving that current embedding models are fundamentally blind to the nuances of scientific discovery.",
      "visual_focus": "A bar chart showing Claude 5.1, Agentic Search, and Dense Baseline struggling to cross the 0.55 threshold.",
      "highlight_words": {
        "fundamentally blind": "#EF4444"
      },
      "svo_action": {
        "subject": "Claude 5.1",
        "action_verb": "hits",
        "direct_object": "performance ceiling",
        "anchor_word": "0.51",
        "semantic_role": "benchmark_result"
