{
  "id": "wanpe_cinematic_prompt_enhancement",
  "title": "WanPE: The Director's Lens",
  "category": "benchmark_news",
  "domain_taxonomy": "algorithmic_search",
  "hook_tag": "VIDEO GENERATION BREAKTHROUGH",
  "beats": [
    {
      "beat_id": 1,
      "text": "How can AI turn a simple text line into a full movie? It starts with a massive, cinematic brain hidden inside the model code.",
      "visual_focus": "A glowing brain icon expanding into a timeline with film strip markers.",
      "highlight_words": {
        "cinematic brain": "#38BDF8"
      },
      "svo_action": {
        "subject": "WanPE",
        "action_verb": "expands",
        "direct_object": "cinematic screenplay",
        "anchor_word": "brain",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 2,
      "text": "Writing long scripts is hard. AI often gets lost in the middle, like a writer forgetting the plot halfway through a long, complex story.",
      "visual_focus": "A tangled ball of yarn representing a broken script sequence.",
      "highlight_words": {
        "gets lost": "#EF4444"
      },
      "svo_action": {
        "subject": "AI Prompt",
        "action_verb": "tangles",
        "direct_object": "script plot",
        "anchor_word": "lost",
        "semantic_role": "state_transition"
      }
    },
    {
      "beat_id": 3,
      "text": "WanPE uses a smart trick called reverse construction. It plans the final shot first, then works back to build the start of the scene.",
      "visual_focus": "An arrow moving right to left from 'End Shot' to 'Start Shot'.",
      "highlight_words": {
        "reverse construction": "#34D399"
      },
      "svo_action": {
        "subject": "WanPE Planner",
        "action_verb": "projects",
        "direct_object": "reverse sequence",
        "anchor_word": "reverse",
        "semantic_role": "agent_action"
      }
    },
    {
      "beat_id": 4,
      "text": "It keeps every piece on track by checking the plan against user goals, pruning away shots that drift from the original vision and intent.",
      "visual_focus": "A filter removing blurry frames from a sequence.",
      "highlight_words": {
        "pruning": "#F59E0B"
      },
      "svo_action": {
        "subject": "SC-GRPO Filter",
        "action_verb": "prunes",
        "direct_object": "drifting shots",
        "anchor_word": "pruning",
        "semantic_role": "causal_elimination"
      }
    },
    {
      "beat_id": 5,
      "text": "This method works. It boosts video quality by over fifty points, proving that smart planning beats simple guessing for long, complex video scenes.",
      "visual_focus": "A bar chart showing a massive spike in preference scores.",
      "highlight_words": {
        "fifty points": "#34D399"
      },
      "svo_action": {
        "subject": "WanPE Model",
        "action_verb": "boosts",
        "direct_object": "preference score",
        "anchor_word": "boosts",
        "semantic_role": "metric_evaluation"
      }
    },
    {
      "beat_id": 6,
      "text": "Follow The Model Verse for simple explanations of how modern AI actually works.",
      "visual_focus": "The Model Verse logo centered on a clean dark screen.",
      "highlight_words": {
        "The Model Verse": "#34D399"
      },
      "svo_action": {
        "subject": "The Model Verse",
        "action_verb": "explains",
        "direct_object": "AI architecture",
        "anchor_word": "Model Verse",
        "semantic_role": "agent_action"
      }
    }
  ],
